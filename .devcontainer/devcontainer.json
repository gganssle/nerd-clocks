{
  "name": "nerd-clocks",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "mounts": [
    "source=claude-code-data,target=/home/node/.claude,type=volume",
    // opencode keeps sessions and provider credentials here; without a volume
    // they are lost on every rebuild.
    "source=opencode-data,target=/home/node/.local/share/opencode,type=volume"
  ],
  // Docker Desktop provides host.docker.internal already; the explicit
  // host-gateway mapping keeps this working under Colima, Podman and plain
  // Linux Docker, where it is not resolvable by default.
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
  "containerEnv": {
    // Hearth (the model server on the host, 0.0.0.0:8080) is OpenAI-compatible,
    // so point the usual SDK env vars at it and it looks like any hosted
    // provider to code running in here.
    "OPENAI_BASE_URL": "http://host.docker.internal:8080/v1",
    // Older openai-python / LangChain releases still read this name.
    "OPENAI_API_BASE": "http://host.docker.internal:8080/v1",
    // Hearth does no auth, but most clients refuse to send a request without
    // some key present.
    "OPENAI_API_KEY": "hearth-local"
  },
  "postCreateCommand": "./.devcontainer/post-create.sh",
  "remoteUser": "node"
}
